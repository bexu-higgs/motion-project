  "lines": [
    {
      "id": "L01",
      "section": "intro",
      "text": "Бұл сабақта видеоға көшпес бұрын сурет генерациялаудың негіздерін үйренеміз.",
      "file": "audio/narration/L01.wav",
      "duration": 5.074,
      "phrases": [
        {
          "text": "Бұл сабақта видеоға көшпес бұрын сурет генерациялаудың негіздерін үйренеміз.",
          "start": 0.0,
          "end": 5.074
        }
      ]
    },
    {
      "id": "L02",
      "section": "model",
      "text": "Image бөліміне кіріп, сурет жасауға арналған негізгі модельді таңдаймыз.",
      "file": "audio/narration/L02.wav",
      "duration": 4.435,
      "phrases": [
        {
          "text": "Image бөліміне кіріп,",
          "start": 0.0,
          "end": 1.325
        },
        {
          "text": "сурет жасауға арналған негізгі модельді таңдаймыз.",
          "start": 1.325,
          "end": 4.435
        }
      ]
    },
    {
      "id": "L03",
      "section": "model",
      "text": "Бұл практикада дайын өнім суретін нұсқаулықпен өңдеуге ыңғайлы Nano Banana моделін қолданамыз.",
      "file": "audio/narration/L03.wav",
      "duration": 6.014,
      "phrases": [
        {
          "text": "Бұл практикада дайын өнім суретін",
          "start": 0.0,
          "end": 2.535
        },
        {
          "text": "нұсқаулықпен өңдеуге ыңғайлы Nano Banana моделін қолданамыз.",
          "start": 2.535,
          "end": 6.014
        }
      ]
    },
    {
      "id": "L04",
      "section": "model",
      "text": "Модель таңдағанда, алдымен мақсатыңызға қараңыз: дайын суретті өзгерту керек пе, белгілі бір стиль керек пе, әлде суреттегі мәтін анық болуы маңызды ма.",
      "file": "audio/narration/L04.wav",
      "duration": 9.485,
      "phrases": [
        {
          "text": "Модель таңдағанда, алдымен мақсатыңызға қараңыз:",
          "start": 0.0,
          "end": 3.02
        },
        {
          "text": "дайын суретті өзгерту керек пе,",
          "start": 3.02,
          "end": 4.92
        },
        {
          "text": "белгілі бір стиль керек пе,",
          "start": 4.92,
          "end": 6.19
        },
        {
          "text": "әлде суреттегі мәтін анық болуы маңызды ма.",
          "start": 6.19,
          "end": 9.485
        }
      ]
    },
    {
      "id": "L05",
      "section": "prompt",
      "text": "Промпт — модельге қандай нәтиже керек екенін түсіндіретін мәтін.",
      "file": "audio/narration/L05.wav",
      "duration": 3.517,
      "phrases": [
        {
          "text": "Промпт — модельге қандай нәтиже керек екенін түсіндіретін мәтін.",
          "start": 0.0,
          "end": 3.517
        }
      ]
    },
    {
      "id": "L06",
      "section": "prompt",
      "text": "Оған нысанды, фонды, жарықты, композицияны және стильді нақты жазамыз.",
      "file": "audio/narration/L06.wav",
      "duration": 4.528,
      "phrases": [
        {
          "text": "Оған нысанды, фонды, жарықты,",
          "start": 0.0,
          "end": 2.025
        },
        {
          "text": "композицияны және стильді нақты жазамыз.",
          "start": 2.025,
          "end": 4.528
        }
      ]
    },
    {
      "id": "L07",
      "section": "ad",
      "text": "Енді қарапайым өнім суретін кәсіби жарнамаға айналдырайық.",
      "file": "audio/narration/L07.wav",
      "duration": 3.483,
      "phrases": [
        {
          "text": "Енді қарапайым өнім суретін кәсіби жарнамаға айналдырайық.",
          "start": 0.0,
          "end": 3.483
        }
      ]
    },
    {
      "id": "L08",
      "section": "ad",
      "text": "Алдымен өнімнің пішінін сақтауды сұрап, фон мен жарықты сипаттаймыз.",
      "file": "audio/narration/L08.wav",
      "duration": 4.017,
      "phrases": [
        {
          "text": "Алдымен өнімнің пішінін сақтауды сұрап,",
          "start": 0.0,
          "end": 2.27
        },
        {
          "text": "фон мен жарықты сипаттаймыз.",
          "start": 2.27,
          "end": 4.017
        }
      ]
    },
    {
      "id": "L09",
      "section": "iterate",
      "text": "Бірінші нәтиже ұнамаса, промпттың бір бөлігін ғана өзгертіп, қайта жасап көреміз.",
      "file": "audio/narration/L09.wav",
      "duration": 5.039,
      "phrases": [
        {
          "text": "Бірінші нәтиже ұнамаса,",
          "start": 0.0,
          "end": 1.595
        },
        {
          "text": "промпттың бір бөлігін ғана өзгертіп,",
          "start": 1.595,
          "end": 3.495
        },
        {
          "text": "қайта жасап көреміз.",
          "start": 3.495,
          "end": 5.039
        }
      ]
    },
    {
      "id": "L10",
      "section": "format",
      "text": "Кадр пішімі суреттің формасын, ал ажыратымдылық оның деталь деңгейін анықтайды.",
      "file": "audio/narration/L10.wav",
      "duration": 5.108,
      "phrases": [
        {
          "text": "Кадр пішімі суреттің формасын,",
          "start": 0.0,
          "end": 2.13
        },
        {
          "text": "ал ажыратымдылық оның деталь деңгейін анықтайды.",
          "start": 2.13,
          "end": 5.108
        }
      ]
    },
    {
      "id": "L11",
      "section": "format",
      "text": "Шаршы постқа, тік сториске немесе көлденең баннерге сай форматты таңдаңыз.",
      "file": "audio/narration/L11.wav",
      "duration": 4.481,
      "phrases": [
        {
          "text": "Шаршы постқа, тік сториске",
          "start": 0.0,
          "end": 1.095
        },
        {
          "text": "немесе көлденең баннерге сай форматты таңдаңыз.",
          "start": 1.095,
          "end": 4.481
        }
      ]
    },
    {
      "id": "L12",
      "section": "practice",
      "text": "Практикада бір өнім суретін және бір негізгі промптты пайдаланып, фон не жарықты өзгерту арқылы бірнеше жарнамалық нұсқа жасаңыз.",
      "file": "audio/narration/L12.wav",
      "duration": 8.23,
      "phrases": [
        {
          "text": "Практикада бір өнім суретін",
          "start": 0.0,
