# @BotFather берген токен
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# PostgreSQL қосылымы (docker compose қолданылса, осы мән жұмыс істейді)
DATABASE_URL=postgresql://mafia:mafia@db:5432/mafia
# Бот әкімшілерінің Telegram ID-лері, үтір арқылы
ADMIN_IDS=
# Тіркелу ұзақтығы (секунд) және кезең уақыттарының көбейткіші
REGISTRATION_SECONDS=120
TIME_SCALE=1.0
# Модерация
RESTRICT_DEAD=true
SILENCE_NIGHT=true
MUTE_NON_PLAYERS=false
REQUIRE_ADMIN_RIGHTS=true
LOG_LEVEL=INFO
