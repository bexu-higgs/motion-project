# @BotFather берген токен
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# PostgreSQL қосылымы (docker compose қолданылса, осы мән жұмыс істейді)
DATABASE_URL=postgresql://mafia:mafia@db:5432/mafia
# Бот әкімшілерінің Telegram ID-лері, үтір арқылы
ADMIN_IDS=
# Әкімші емес, бірақ ботпен жеке чатта /getdiamonds арқылы өзіне алмаз ала алатын ID-лер, үтір арқылы
GETDIAMONDS_IDS=
# Әдепкі тіркелу ұзақтығы (секунд). Әр чат оны /settingsmafiahiggs арқылы өзгерте алады.
REGISTRATION_SECONDS=120
TIME_SCALE=1.0
# Модерация: ойын кезінде бөгделер мен өлгендердің хабарын өшіріп, осынша секундқа үнсіз ету
MUTE_SECONDS=120
MUTE_NON_PLAYERS=true
# Түнде барлық ойыншының топтағы хабарын өшіру (әкімшілер «!» белгісімен жаза алады)
SILENCE_NIGHT=true
REQUIRE_ADMIN_RIGHTS=true
LOG_LEVEL=INFO
