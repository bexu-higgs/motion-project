{
  "name": "higgsfield-max-tutorial",
  "version": "1.0.0",
  "private": true,
  "description": "Higgsfield MAX discount \u2014 motion design tutorial (16:9, 1080p, Kazakh VO)",
  "scripts": {
    "assets": "python3 scripts/prepare_assets.py && python3 scripts/make_sfx.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HiggsfieldMaxTutorial out/higgsfield-max-tutorial.mp4",
    "cues": "tsx scripts/export-cues.ts",
    "sync-vo": "node scripts/sync-vo.mjs",
    "timeline": "tsx scripts/print-timeline.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@remotion/cli": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
