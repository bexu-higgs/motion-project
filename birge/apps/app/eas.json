{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "BIRGE_IOS_BUNDLE_ID": "kz.birge.app",
        "BIRGE_ANDROID_PACKAGE": "kz.birge.app",
        "BIRGE_DOMAIN": "birge.example.kz",
        "EXPO_PUBLIC_OPERATOR_NAME": "Birge"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://birge.example.kz" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://birge.example.kz" }
    }
  },
  "submit": {
    "production": {}
  }
}
