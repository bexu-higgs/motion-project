# ===== Домендер (docker-compose) =====
APP_DOMAIN=birge.example.kz
LIVEKIT_DOMAIN=lk.birge.example.kz
POSTGRES_PASSWORD=change-me-long-random
# Құқықтық құжаттарда көрсетілетін ұйым атауы мен мекенжайы
OPERATOR_NAME="ЖШС «Мысал», Алматы қ."

# ===== Сервер =====
# openssl rand -base64 48
SECRET=
WEB_URL=https://birge.example.kz
SUPPORT_EMAIL=support@birge.example.kz
MAX_UPLOAD_MB=4096
# Шағымдарды қарайтын модераторлардың поштасы (үтір арқылы)
MODERATOR_EMAILS=admin@birge.example.kz
# App Review / Google Play тексерушілеріне арналған тұрақты код (пошта:6 сан)
REVIEW_LOGINS=review@birge.example.kz:246810

# ===== Пошта арқылы кіру (SMTP) — продакшнда міндетті =====
# SMTP_URL=smtps://user:password@smtp.example.kz:465
MAIL_FROM="Birge <no-reply@birge.example.kz>"

# ===== Телефон арқылы кіру (SMS) =====
# none — телефон батырмасы көрсетілмейді; twilio — нақты SMS
SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# немесе TWILIO_MESSAGING_SERVICE_SID=

# ===== Google арқылы кіру (Google Cloud Console → OAuth client: Web application) =====
# Redirect URI: https://birge.example.kz/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Apple арқылы кіру (developer.apple.com) =====
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 кілтінің мазмұны (жаңа жолдарды \n етіп)
APPLE_PRIVATE_KEY=
# iOS қосымшасының Bundle ID
APPLE_BUNDLE_ID=kz.birge.app
# Веб/Android үшін Services ID; Return URL: https://birge.example.kz/api/auth/oauth/apple/callback
APPLE_SERVICES_ID=kz.birge.web

# ===== Android App Links (шақыру сілтемесі қосымшаны ашуы үшін) =====
ANDROID_PACKAGE=kz.birge.app
# Play Console → App integrity → App signing key SHA-256
ANDROID_CERT_SHA256=

# ===== LiveKit (дауыстық чат, экран бөлісу) =====
# openssl rand -hex 16 / openssl rand -base64 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
