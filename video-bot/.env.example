# @BotFather берген токен
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# YouTube/Instagram/Facebook cookies файлы (Netscape форматы, браузерден экспортталады).
# YouTube серверді «бот» деп бөгесе немесе Instagram кіруді талап етсе керек. Бос болса — қолданылмайды.
COOKIES_FILE=

# Жіберілетін файлдың ең үлкен өлшемі (МБ). Telegram-ның бұлттағы Bot API шегі — 50.
MAX_FILE_MB=50

# Жеке Bot API сервері (https://github.com/tdlib/telegram-bot-api, --local режимі).
# Көрсетілсе, 2000 МБ-қа дейінгі файлдар жіберіледі (MAX_FILE_MB әдепкіде 2000 болады).
# Сервер бот тұрған компьютерде іске қосылып, downloads/ қалтасын көре алуы керек.
BOT_API_URL=

# Сайттарға прокси арқылы қосылу (мысалы, socks5://127.0.0.1:1080). Бос — проксисіз.
PROXY=

# Бір уақытта қатар жүретін жүктеулер саны
MAX_PARALLEL=3

# Уақытша файлдар қалтасы
DOWNLOAD_DIR=downloads
