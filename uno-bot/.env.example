# @BotFather берген токен
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Сіздің Telegram ID-іңіз (@userinfobot арқылы білуге болады).
# Стикер жинақтары осы адамның атына жасалады; ол ботқа жеке чатта /start жазуы керек.
ADMIN_ID=

# Жүріске берілетін уақыт (секунд). 0 — шектеусіз.
TURN_TIMEOUT=90

# Дайын стикер пагы (https://t.me/addstickers/UnoWarStickers). Бос қалдырсаңыз — боттың өз стикерлері.
STICKER_PACK=UnoWarStickers

# Пак стикерлерін карталарға сәйкестендіру файлы (әдепкі: unobot/packs/<пак>.json)
STICKER_MAP=

# Боттың өз стикерлерінің file_id-лері сақталатын файл
STICKERS_FILE=data/stickers.json

# Стикер жинақтары атауының басы: <prefix>_cards_by_<бот_аты>
STICKER_PREFIX=unokz
