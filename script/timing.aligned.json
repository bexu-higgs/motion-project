  "captions": [
    {
      "scene": "intro",
      "index": 0,
      "start": 1.0,
      "end": 5.8,
      "text": "Бұл модульде Higgsfield арқылы алғашқы AI видеоңызды өзіңіз жасайсыз."
    },
    {
      "scene": "video",
      "index": 0,
      "start": 10.5,
      "end": 14.62,
      "text": "Video бөліміне өтіп, алдымен қандай жолмен бастайтыныңызды таңдаңыз:"
    },
    {
      "scene": "video",
      "index": 1,
      "start": 14.9,
      "end": 16.73,
      "text": "Text-to-Video — мәтіннен,"
    },
    {
      "scene": "video",
      "index": 2,
      "start": 17.0,
      "end": 19.65,
      "text": "Image-to-Video — суреттен видео жасау."
    },
    {
      "scene": "t2v",
      "index": 0,
      "start": 25.5,
      "end": 29.41,
      "text": "Text-to-Video үшін кейіпкерді, әрекетті, орынды,"
    },
    {
      "scene": "t2v",
      "index": 1,
      "start": 29.41,
      "end": 31.73,
      "text": "көңіл-күйді және камераны сипаттаңыз."
    },
    {
      "scene": "t2v",
      "index": 2,
      "start": 32.03,
      "end": 36.4,
      "text": "Мысалы: “Кешкі қалада кейіпкер жаңбыр астында баяу жүріп келеді."
    },
    {
      "scene": "t2v",
      "index": 3,
      "start": 36.7,
      "end": 38.79,
      "text": "Камера артынан бірқалыпты ілеседі."
    },
    {
      "scene": "t2v",
      "index": 4,
      "start": 39.06,
      "end": 42.73,
      "text": "Неон шамдардың шағылысы, кинематографиялық жарық.”"
    },
    {
      "scene": "i2v",
      "index": 0,
      "start": 50.5,
      "end": 54.45,
      "text": "Image-to-Video үшін сурет жүктеп, бастапқы көріністі анықтаңыз."
    },
    {
      "scene": "i2v",
      "index": 1,
      "start": 54.78,
      "end": 59.21,
      "text": "Сурет не көрсететінін, кейіпкер қандай бір қарапайым әрекет жасайтынын,"
    },
    {
      "scene": "i2v",
      "index": 2,
      "start": 59.21,
      "end": 61.34,
      "text": "камера қалай қозғалатынын жазыңыз."
    },
    {
      "scene": "i2v",
      "index": 3,
      "start": 61.7,
      "end": 64.08,
      "text": "Кадрда бірден көп әрекет бермеңіз:"
    },
    {
      "scene": "i2v",
      "index": 4,
      "start": 64.08,
      "end": 67.44,
      "text": "қозғалыс анық әрі қарапайым болса басқару оңай."
    },
    {
      "scene": "model",
      "index": 0,
      "start": 75.5,
      "end": 77.52,
      "text": "Модельді мақсатқа қарай таңдаңыз:"
    },
    {
      "scene": "model",
      "index": 1,
      "start": 77.52,
      "end": 81.38,
      "text": "суреттен анимация жасау керек пе, табиғи қозғалыс маңызды ма,"
    },
    {
      "scene": "model",
      "index": 2,
      "start": 81.38,
      "end": 85.04,
      "text": "камера бағытын басқару керек пе — алдымен осыны тексеріңіз."
    },
    {
      "scene": "model",
      "index": 3,
      "start": 85.41,
      "end": 87.37,
      "text": "Модель тізіміндегі сипаттаманы қарап,"
    },
    {
      "scene": "model",
      "index": 4,
      "start": 87.37,
      "end": 91.4,
      "text": "сол кіріс түрі мен қажетті баптаулар қолжетімді екенін тексеріңіз."
    },
    {
      "scene": "model",
      "index": 5,
      "start": 91.75,
      "end": 94.74,
      "text": "Бұл сабақта тәжірибеге бір негізгі модельді таңдап,"
    },
    {
      "scene": "model",
      "index": 6,
      "start": 94.74,
      "end": 96.27,
      "text": "сонымен жұмыс істейміз."
    },
    {
      "scene": "settings",
      "index": 0,
      "start": 97.37,
      "end": 101.08,
      "text": "Ұзақтық пен ажыратымдылықты қолжетімді опциялардан таңдаңыз."
    },
    {
      "scene": "settings",
      "index": 1,
      "start": 101.46,
      "end": 103.77,
      "text": "Алғашқы сынақта қысқа клип жасаңыз;"
    },
    {
      "scene": "settings",
      "index": 2,
      "start": 103.77,
      "end": 106.74,
      "text": "қозғалыс ұнаған соң ғана финал сапасын көтеріңіз."
    },
    {
      "scene": "settings",
      "index": 3,
      "start": 107.1,
      "end": 110.17,
      "text": "Кадр пішімін жариялайтын платформаңызға сай қойыңыз."
    },
    {
      "scene": "split",
      "index": 0,
      "start": 114.37,
      "end": 118.23,
      "text": "Промптта кейіпкер әрекеті мен камера қозғалысын бөлек ойлаңыз:"
    },
    {
      "scene": "split",
      "index": 1,
      "start": 118.23,
      "end": 121.11,
      "text": "“кейіпкер басын бұрып күлімсірейді” — әрекет;"
    },
    {
      "scene": "split",
      "index": 2,
      "start": 121.11,
      "end": 124.17,
      "text": "“камера баяу жақындайды” — камера қозғалысы."
    },
    {
      "scene": "review",
      "index": 0,
      "start": 132.37,
      "end": 136.0,
      "text": "Нәтижені қарағанда кейіпкердің пішіні, қозғалыстың үздіксіздігі"
    },
    {
      "scene": "review",
      "index": 1,
      "start": 136.0,
      "end": 138.95,
      "text": "және камера командасы сақталғанын тексеріңіз."
    },
    {
      "scene": "review",
      "index": 2,
      "start": 139.27,
      "end": 142.19,
      "text": "Қате болса бір өзгерісті түзеп қайта жасаңыз."
    },
    {
      "scene": "practice",
      "index": 0,
      "start": 147.37,
      "end": 151.81,
      "text": "Практика: бір суретті жүктеп, қысқа кинематографиялық видео жасаңыз."
    },
    {
      "scene": "practice",
      "index": 1,
      "start": 152.1,
      "end": 156.25,
      "text": "Бір қарапайым әрекет, бір камера қозғалысы, қысқа ұзақтық."
    },
    {
      "scene": "practice",
      "index": 2,
      "start": 156.53,
      "end": 159.44,
      "text": "Нұсқаларды салыстырып, ең сәттісін таңдаңыз."
    }
  ]
}
